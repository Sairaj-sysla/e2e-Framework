node_modules/
# .e2e/cache/ is committed on purpose: CI replays verified agent.act steps
# with no model calls. Entries hold action summaries and digests, never secrets.
.e2e/artifacts/
.e2e/sessions/
.e2e/report.json
.e2e/ai-trace.json
.e2e/junit.xml
.e2e/summary.md
.e2e/failures/
.e2e/logs/
.e2e/videos/

# Local secrets: never commit API keys or real credentials
.env
.env.*
!.env.example

# Local health history and summary (CI keeps its own as artifacts)
reports/
