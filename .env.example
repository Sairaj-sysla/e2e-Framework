# TEMPLATE ONLY: this file is committed and never loaded.
# Copy it to .env (git-ignored), and put real values in .env, not here.

# Required for agent.* steps (agent.act, agent.assert, ...). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_actual_key_here

# Optional: cap on output tokens per model request (default 4096; lower it on a low-credit account)
# OPENROUTER_MAX_TOKENS=4096

# Optional: any tool-calling model id OpenRouter serves (default: openai/gpt-6-luna)
# OPENROUTER_MODEL=

# Optional: test an app that is already running instead of the bundled demo app
# APP_URL=http://localhost:4200

# Optional: override the demo account for a real app (read by the e2e runner)
# E2E_USER_DEMO_USERNAME=
# E2E_USER_DEMO_PASSWORD=

# Optional: mobile targets. Each one joins the run only when its app is set.
# iOS needs macOS with Xcode; Android needs the Android SDK. Run `npx agent-device doctor` once.
# IOS_BUNDLE_ID=com.example.app
# IOS_APP_PATH=builds/MyApp.app
# IOS_DEVICE=iPhone 17,iPhone 17 Pro
# ANDROID_PACKAGE=com.example.app
# ANDROID_APP_PATH=builds/app-debug.apk
# ANDROID_DEVICE=emulator-5554
